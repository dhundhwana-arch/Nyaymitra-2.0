# The CSP connect source list must include the backend origin when frontend and backend are separate websites.
# Run: python scripts/configure_frontend.py --api-base https://YOUR-BACKEND
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-XSS-Protection: 1; mode=block
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self';
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

/manifest.webmanifest
  Content-Type: application/manifest+json

/sw.js
  Content-Type: application/javascript
  Service-Worker-Allowed: /

/app.js
  Content-Type: application/javascript

/styles.css
  Content-Type: text/css

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/config.js
  Content-Type: application/javascript
  Cache-Control: no-cache
