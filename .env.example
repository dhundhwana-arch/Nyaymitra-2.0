# NYAYMITRA 2.0 — environment template.
# Copy to .env (never commit it) and fill in only what you need.
# Every variable is optional: with none set, the app runs in offline, source-grounded mode.

# ---------------------------------------------------------------- runtime
NYAYMITRA_ENV=development
NYAYMITRA_HOST=0.0.0.0
NYAYMITRA_PORT=8000
NYAYMITRA_LOG_LEVEL=INFO
NYAYMITRA_DB_PATH=data/nyaymitra.db
NYAYMITRA_STORAGE_DIR=storage/documents
NYAYMITRA_SERVE_WEB=true
# Origins of a SEPARATELY hosted frontend that may call this API (CORS), comma separated.
# Leave empty when the backend serves the website itself (same origin).
# Example: NYAYMITRA_ALLOWED_ORIGINS=https://nyaymitra-frontend.pages.dev
NYAYMITRA_ALLOWED_ORIGINS=

# ---------------------------------------------------------------- access
# Leave both empty to disable /admin entirely (it then returns 403).
NYAYMITRA_ADMIN_TOKEN=
NYAYMITRA_MONITOR_TOKEN=

# ---------------------------------------------------------------- AI provider
# auto               : use a live provider if credentials exist, else offline grounded
# offline            : always rule-based, source-grounded (no network)
# openai_compatible  : require a live OpenAI-compatible endpoint
NYAYMITRA_AI_PROVIDER=auto
NYAYMITRA_AI_BASE_URL=
NYAYMITRA_AI_MODEL=
NYAYMITRA_AI_API_KEY=
NYAYMITRA_AI_TIMEOUT_S=20
NYAYMITRA_AI_MAX_OUTPUT_TOKENS=700
# strict            : return 503 when the configured provider fails
# offline_grounded  : fall back to the deterministic, citation-only answer (default)
NYAYMITRA_AI_FALLBACK_MODE=offline_grounded

# Google Gemini through its OpenAI-compatible endpoint:
#   NYAYMITRA_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   NYAYMITRA_AI_MODEL=gemini-2.0-flash
# Groq:   NYAYMITRA_AI_BASE_URL=https://api.groq.com/openai/v1
# Ollama: NYAYMITRA_AI_BASE_URL=http://127.0.0.1:11434/v1  (model e.g. llama3.1)

# ---------------------------------------------------------------- limits
NYAYMITRA_MAX_BODY_BYTES=524288
NYAYMITRA_MAX_UPLOAD_BYTES=10485760
NYAYMITRA_RATE_LIMIT_WINDOW_S=60
NYAYMITRA_RATE_LIMIT_READ=120
NYAYMITRA_RATE_LIMIT_WRITE=30
NYAYMITRA_RATE_LIMIT_AI=20
NYAYMITRA_RATE_LIMIT_ADMIN=10
NYAYMITRA_TRUST_PROXY_HEADERS=false
NYAYMITRA_PII_RETENTION_DAYS=180
