# systemd unit for a single-host deployment.
#   sudo cp deploy/nyaymitra.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now nyaymitra
[Unit]
Description=NYAYMITRA 2.0 legal-aid assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=nyaymitra
Group=nyaymitra
WorkingDirectory=/opt/nyaymitra
EnvironmentFile=/etc/nyaymitra.env
ExecStart=/opt/nyaymitra/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5

# Hardening: the service only needs its own data directory.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/nyaymitra
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
