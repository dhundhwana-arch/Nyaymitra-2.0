# Copy to /etc/nyaymitra.env, chmod 600, chown root:root. Never commit the real file.
NYAYMITRA_ENV=production
NYAYMITRA_HOST=127.0.0.1
NYAYMITRA_PORT=8000
NYAYMITRA_LOG_LEVEL=INFO
NYAYMITRA_DB_PATH=/var/lib/nyaymitra/nyaymitra.db
NYAYMITRA_STORAGE_DIR=/var/lib/nyaymitra/documents
NYAYMITRA_BACKUP_DIR=/var/lib/nyaymitra/backups

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The service refuses to start in production with the placeholder values below.
NYAYMITRA_ADMIN_TOKEN=replace-with-a-random-32-byte-token
NYAYMITRA_MONITOR_TOKEN=replace-with-a-different-random-token

# Keep the offline provider unless a reviewed model endpoint is available.
NYAYMITRA_AI_PROVIDER=offline
NYAYMITRA_AI_BASE_URL=
NYAYMITRA_AI_MODEL=
NYAYMITRA_AI_API_KEY=
NYAYMITRA_AI_FALLBACK_MODE=offline_grounded

NYAYMITRA_RATE_LIMIT_READ=120
NYAYMITRA_RATE_LIMIT_WRITE=30
NYAYMITRA_RATE_LIMIT_AI=20
NYAYMITRA_RATE_LIMIT_ADMIN=10
NYAYMITRA_PII_RETENTION_DAYS=180
